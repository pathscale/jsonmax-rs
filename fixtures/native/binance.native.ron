// Native decoder specification for fixtures/native/binance.ron.
NativeSpec(
    roots: ["AggTrade", "DepthUpdate", "DepthSnapshot"],
    tuples: ["PriceLevel"],
    reject_unknown: true,
    idents: [
        Ident("AggTrade", "e", "event_type"),
        Ident("AggTrade", "E", "event_time_ms"),
        Ident("AggTrade", "s", "symbol"),
        Ident("AggTrade", "a", "aggregate_trade_id"),
        Ident("AggTrade", "p", "price"),
        Ident("AggTrade", "q", "quantity"),
        Ident("AggTrade", "f", "first_trade_id"),
        Ident("AggTrade", "l", "last_trade_id"),
        Ident("AggTrade", "T", "trade_time_ms"),
        Ident("AggTrade", "m", "buyer_is_maker"),
        Ident("AggTrade", "M", "best_match"),
        Ident("DepthUpdate", "e", "event_type"),
        Ident("DepthUpdate", "E", "event_time_ms"),
        Ident("DepthUpdate", "s", "symbol"),
        Ident("DepthUpdate", "U", "first_update_id"),
        Ident("DepthUpdate", "u", "final_update_id"),
        Ident("DepthUpdate", "b", "bids"),
        Ident("DepthUpdate", "a", "asks"),
        Ident("DepthSnapshot", "lastUpdateId", "last_update_id"),
    ],
)
